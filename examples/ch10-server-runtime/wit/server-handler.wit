package book:server-handler@1.0.0;

world server-handler {
    record request {
        path: string,
        body: string,
        work: u64,
    }

    record response {
        status: u16,
        body: string,
    }

    /// Handles one application request. Domain failures are explicit results;
    /// traps and resource exhaustion remain runtime failures.
    export handle: func(request: request) -> result<response, string>;
}
